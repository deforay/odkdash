# Local settings for developer tools. Copy to .env, which is not tracked.
# Only bin/dev/review reads this file, and only its REVIEW_* keys.

# The CLI that performs the adversarial review, as a full command line: the binary plus
# whatever subcommand or flag makes it review non-interactively. For example:
#   REVIEW_AGENT='<your-review-cli> review'
#   REVIEW_AGENT='<your-review-cli> -p'
# Set it in your own untracked .env, or export it from your shell profile. Deliberately
# left empty in the example so no tool name is committed.
REVIEW_AGENT=
# Set to 1 if that CLI reads its prompt from standard input instead of a final argument.
REVIEW_AGENT_STDIN=
# A second review CLI, used only when the first stops because it is out of usage (it exits
# non-zero with a message matching REVIEW_LIMIT_PATTERN). Same form as REVIEW_AGENT; leave
# empty for none. It must be able to read the repository without prompting.
REVIEW_AGENT_FALLBACK=
REVIEW_AGENT_FALLBACK_STDIN=
# What an out-of-usage message looks like (extended regex, case-insensitive).
# REVIEW_LIMIT_PATTERN='usage limit|rate limit|quota'

# Add the refutation pass to every run without typing --verify. Doubles the cost.
# REVIEW_VERIFY=1

# Where the reviewed-commit ledger lives. Defaults to inside .git.
# REVIEW_LEDGER=
