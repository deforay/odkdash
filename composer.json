{
    "name": "deforay/odkdash",
    "description": "SPI RRT Dashboard",
    "type": "project",
    "version": "1.2.3",
    "keywords": [
        "vl",
        "eid",
        "spi-rt",
        "spi-rrt"
    ],
    "require": {
        "php": "^8.4",
        "amitdugar/db-tools": "^3.3",
        "composer/semver": "^3.4",
        "crunzphp/crunz": "^3.9",
        "guzzlehttp/guzzle": "^8.0",
        "hackzilla/password-generator": "^1.7",
        "halaxa/json-machine": "^1.2",
        "laminas/laminas-db": "^2.22",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-router": "^3.18",
        "monolog/monolog": "^3.10",
        "phpmyadmin/sql-parser": "^6.0",
        "phpoffice/phpspreadsheet": "^5.7",
        "psr/container": "^1.1",
        "ramsey/uuid": "^4.9",
        "setasign/fpdi": "^2.6",
        "shuchkin/simplexlsxgen": "^1.5",
        "symfony/console": "^8.1",
        "symfony/mailer": "^8.0",
        "symfony/translation": "^8.1",
        "szymach/c-pchart": "^3.1",
        "tecnickcom/tcpdf": "^6.11"
    },
    "autoload": {
        "psr-4": {
            "Application\\": "module/Application/src/Application/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApplicationTest\\": "module/Application/test/"
        }
    },
    "scripts": {
        "serve": "php -S 0.0.0.0:8080 -t public",
        "migrate": "php bin/migrate",
        "migrate-status": "php bin/migrate --status",
        "migrate-dry-run": "php bin/migrate --dry-run"
    },
    "scripts-descriptions": {
        "serve": "Start the built-in PHP web server and serve the application.",
        "migrate": "Apply pending database migrations.",
        "migrate-status": "Show current DB version and pending migrations.",
        "migrate-dry-run": "Preview pending migration statements without executing."
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "secure-http": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "require-dev": {
        "symfony/var-dumper": "^8.0"
    }
}
