#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Console runner for odkdash.
 *
 * Commands are declared under the 'console' key in
 * module/Application/config/module.config.php, mapping a command name to a
 * class ServiceDefinitions can build.
 *
 * Usage:
 *   php bin/console list             show the available commands
 *   php bin/console <name> [options]
 */

chdir(dirname(__DIR__));
require_once 'vendor/autoload.php';

use App\Services\ServiceDefinitions;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\CommandLoader\FactoryCommandLoader;

// The same services the web app and bin/migrate use, without the web
// app's locale step. That step reads global_config out of the database,
// which a console command should not depend on.
$services = ServiceDefinitions::container(getcwd());

$commands = $services->get('config')['console']['commands'] ?? [];

// Lazy, so a single command run does not construct the other five and their
// database connections. The name lives in the config map rather than on the
// class, so it is bound at construction.
$factories = [];
foreach ($commands as $name => $class) {
    $factories[$name] = static function () use ($services, $class, $name): Command {
        $command = $services->get($class);

        if (!$command instanceof Command) {
            throw new RuntimeException(sprintf(
                'Command "%s" maps to %s, which is not a %s.',
                $name,
                get_debug_type($command),
                Command::class
            ));
        }

        $command->setName($name);

        return $command;
    };
}

$version = json_decode((string) file_get_contents('composer.json'), true)['version'] ?? 'unknown';

$application = new Application('odkdash', (string) $version);
$application->setCommandLoader(new FactoryCommandLoader($factories));

exit($application->run());
