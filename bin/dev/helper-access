#!/usr/bin/env php
<?php

/**
 * Writes config/helper-access.php: for each route action, the pages whose
 * templates call it. See src/Http/HelperAccess.php for how it is used.
 *
 * Usage:
 *   bin/dev/helper-access           # regenerate the map
 *   bin/dev/helper-access --check   # exit 1 when the map is out of date
 *
 * A template at templates/application/<dir>/<name>.phtml is the page
 * <Dir>Controller / <name>. A call is either url('<route>', ['action' => 'x'])
 * or a literal '/<route prefix>/x' path. Lines that start a comment are
 * skipped, so commented-out calls grant nothing.
 */

declare(strict_types=1);

use App\Http\Kernel;
use Application\Model\Acl;

chdir(dirname(__DIR__, 2));
require 'vendor/autoload.php';

$controller = static fn(string $slug): string
    => 'Application\\Controller\\' . str_replace(' ', '', ucwords(str_replace('-', ' ', $slug))) . 'Controller';

// Route name => [path prefix, resource]: the Slim routes, then the segment
// routes still on Laminas.
$routes = [];
foreach (Kernel::CONTROLLERS as $name => [$pattern, , $resource]) {
    $routes[$name] = [strstr($pattern, '[', true), 'Application\\Controller\\' . $resource];
}
$config = require 'module/Application/config/module.config.php';
foreach ($config['router']['routes'] as $name => $route) {
    $pattern = $route['options']['route'] ?? '';
    // A route with no literal prefix, such as the landing page's, would
    // match every path.
    if (!isset($routes[$name]) && str_contains($pattern, '[/:action]') && !str_starts_with($pattern, '[')) {
        $routes[$name] = [strstr($pattern, '[', true), $route['options']['defaults']['controller']];
    }
}

$viewRoot = 'templates/application/';
$files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($viewRoot, FilesystemIterator::SKIP_DOTS));
$map = [];
foreach ($files as $file) {
    if ($file->getExtension() !== 'phtml') {
        continue;
    }
    $relative = substr($file->getPathname(), strlen($viewRoot));
    $page = [$controller(dirname($relative)), basename($relative, '.phtml')];

    $lines = array_filter(
        file($file->getPathname()),
        static fn(string $line): bool => !preg_match('~^\s*(//|#|\*|/\*|<!--)~', $line),
    );
    $source = implode('', $lines);

    foreach ($routes as $name => [$prefix, $resource]) {
        $q = preg_quote($name, '~');
        preg_match_all("~url\(\s*['\"]{$q}['\"]\s*,\s*(?:array\(|\[)\s*['\"]action['\"]\s*=>\s*['\"]([\w-]+)['\"]~", $source, $byName);
        preg_match_all('~(?<=[\'"])' . preg_quote($prefix, '~') . '/([A-Za-z][\w-]*)~', $source, $byPath);
        foreach (array_merge($byName[1], $byPath[1]) as $action) {
            $key = Acl::normalise($action);
            if ([$resource, Acl::normalise($page[1])] === [$page[0], $key]) {
                continue;
            }
            $map[$resource][$key][implode(' ', $page)] = $page;
        }
    }
}

ksort($map);
foreach ($map as &$actions) {
    ksort($actions);
    foreach ($actions as &$pages) {
        ksort($pages);
        $pages = array_values($pages);
    }
}
unset($actions, $pages);

$out = "<?php\n\n// Generated by bin/dev/helper-access. Do not edit.\n// resource => normalised action => pages whose templates call it.\n\nreturn "
    . var_export($map, true) . ";\n";
$target = 'config/helper-access.php';

if (in_array('--check', $argv, true)) {
    if (!is_file($target) || file_get_contents($target) !== $out) {
        fwrite(STDERR, "$target is out of date. Run bin/dev/helper-access.\n");
        exit(1);
    }
    exit(0);
}
file_put_contents($target, $out);
echo "Wrote $target\n";
