includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - module/Application/src
        - module/Application/Module.php
        - module/Application/config
        - config
        - tasks
        - bin/console
        - bin/migrate
        - db-tools.php
    excludePaths:
        - config/autoload/*.local.php (?)
    fileExtensions:
        - php
    # APPLICATION_PATH and the other path constants are defined here, and the app
    # loads it through the config glob, which PHPStan does not follow.
    bootstrapFiles:
        - config/autoload/constants.global.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    # The session container exposes keys through __get/__set. Ignored by pattern
    # rather than baselined per file, so the baseline does not drift every time
    # someone reads another session key.
    ignoreErrors:
        -
            message: '#^Access to an undefined property Application\\Session\\Container::\$\w+\.$#'
