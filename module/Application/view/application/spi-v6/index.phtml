<script type="text/javascript">
  table = null;

  function formatValue(value) {
    //return '<a href="/spi-v3/print/'+value+'" target="_blank"><i class="fa fa-print"></i> Print Full Survey</a>'
    return '<a href="javascript:void(0);" onclick="downloadPdf(' + value + ')" ><i class="fa fa-print"></i> <?= $this->translate('Print Full Survey'); ?></a>' +
      '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;' +
      '<a href="javascript:void(0)" onclick="downloadCorrectiveActionPdf(' + value + ')" ><i class="fa fa-print"></i> <?= $this->translate('Print Corrective Actions'); ?></a>';
  }
  $(document).ready(function () {
    var startDate = "";
    var endDate = "";
    // $("#province").multipleSelect({
    //   placeholder: '< ?= $this->translate('Select Province/District(s)'); ?>',
    //   width: '100%'
    // });
    $('#date').daterangepicker({
      format: 'DD-MMM-YYYY',
      startDate: moment().subtract('days', 29),
      endDate: moment(),
      maxDate: moment(),
      ranges: {
        '<?= $this->translate('Today'); ?>': [moment(), moment()],
				'<?= $this->translate('Yesterday'); ?>': [moment().subtract('days', 1), moment().subtract('days', 1)],
				'<?= $this->translate('Last 7 Days'); ?>': [moment().subtract('days', 6), moment()],
				'<?= $this->translate('Last 30 Days'); ?>': [moment().subtract('days', 29), moment()],
				'<?= $this->translate('This Month'); ?>': [moment().startOf('month'), moment().endOf('month')],
				'<?= $this->translate('Last Month'); ?>': [moment().subtract('month', 1).startOf('month'), moment().subtract('month', 1).endOf('month')],
				'<?= $this->translate('Last 6 Months'); ?>': [moment().subtract('months', 6), moment()],
				'<?= $this->translate('Last 12 Months'); ?>': [moment().subtract('months', 12), moment()],
				'<?= $this->translate('Last 18 Months'); ?>': [moment().subtract('months', 18), moment()],
				'<?= $this->translate('Last 2 Years'); ?>': [moment().subtract('years', 2), moment()]
      }
    },
      function (start, end) {
        startDate = start.format('YYYY-MM-DD');
        endDate = end.format('YYYY-MM-DD');
        /* This build of daterangepicker reports through this callback rather than
         * firing apply.daterangepicker, so the highlighter never hears about a date
         * being picked and the field stayed unhighlighted until some other filter
         * changed. Tell it directly. */
        filterHighlighter.refresh();
        updateFilterCount();
      });
    table = $('#example').DataTable({
      "bProcessing": true,
      "bServerSide": true,
      "aoColumns": [
        <?php echo $editAction; ?>
      ],
      "iDisplayLength": 50,
      "pageLength": 50,
      "aaSorting": [
        [3, "desc"]
      ],
      "sAjaxSource": "<?php echo $this->url('spi-v6-form', array('action' => 'index')); ?>",
      "fnServerData": function (sSource, aoData, fnCallback) {
        aoData.push({
          "name": "auditRndNo",
          "value": $("#auditRndNo").val()
        });
        aoData.push({
          "name": "dateRange",
          "value": $("#date").val()
        });
        aoData.push({
          "name": "testPoint",
          "value": $("#testPoint").val()
        });
        aoData.push({
          "name": "testPointName",
          "value": $("#testPointName").val()
        });
        aoData.push({
          "name": "affiliation",
          "value": $("#affiliation").val()
        });

        aoData.push({
          "name": "scoreLevel",
          "value": $("#scoreLevel").val()
        });
        aoData.push({
          "name": "country",
          "value": $("#country").val()
        });
        aoData.push({
          "name": "province",
          "value": $("#province").val()
        });
        aoData.push({
          "name": "district",
          "value": $("#district").val()
        });
        aoData.push({
          "name": "showAudits",
          "value": $("#showAudits").val()
        });
        aoData.push({
          "name": "facilityLink",
          "value": $("#facilityLink").val()
        });
        $.ajax({
          "dataType": 'json',
          "type": "POST",
          "url": sSource,
          "data": aoData,
          "success": function (json) {
            $.unblockUI();
            $("#totalAudit").html(json.iTotalDisplayRecords);
            $("#avgAuditScore").html(json.avgAuditScore + "%");
            $("#level0").html(json.levelZeroCount);
            $("#level1").html(json.levelOneCount);
            $("#level2").html(json.levelTwoCount);
            $("#level3").html(json.levelThreeCount);
            $("#level4").html(json.levelFourCount + "&nbsp;");
            updateNeedsAttention(json.unassigned, json.duplicate);
            fnCallback(json);
          }
        });
      }
    });
    //
    //var table = $('#example').DataTable({"order": [[1, 'asc']]});
    //
    // Add event listener for opening and closing details
    $('#example').on('click', 'td.details-control', function () {
      var tr = $(this).closest('tr');
      var row = table.row(tr);

      if (row.child.isShown()) {
        // This row is already open - close it
        row.child.hide();
        tr.removeClass('shown');
      } else {
        // Open this row
        row.child(formatValue(tr.attr('id'))).show();
        tr.addClass('shown');
      }
    });

    $("#country").select2({
      width: '100%',
      placeholder: 'All',
      allowClear: true,
      tags: false
    });

    $("#province").select2({
      width: '100%',
      placeholder: 'All',
      allowClear: true,
      tags: false
    });

    $("#district").select2({
      width: '100%',
      placeholder: 'All',
      allowClear: true,
      tags: false
    });
    getLocations();

    /* The filter panel filled the screen before a single audit was visible, so it
       starts closed and the audit list is what you land on. Hiding filters hides
       what they are doing, so the badge counts the ones that are set — otherwise a
       filtered list is indistinguishable from the whole list. The open/closed
       choice is remembered for people who keep it open. */
    var FILTER_IDS = ['#date', '#auditRndNo', '#affiliation', '#scoreLevel', '#country',
      '#province', '#district', '#testPoint', '#showAudits', '#facilityLink'];

    function updateFilterCount() {
      var n = 0;
      $.each(FILTER_IDS, function (i, id) {
        var v = $(id).val();
        if ($.isArray(v)) {
          // "All" is an empty-valued option inside the multi-selects.
          if ($.grep(v, function (x) { return x !== '' && x !== null; }).length) {
            n++;
          }
        } else if (v !== '' && v !== null && typeof v !== 'undefined') {
          n++;
        }
      });
      $('#activeFilterCount').text(n > 0 ? ' (' + n + ')' : '');
      $('#clearFilters').toggle(n > 0);
    }

    function setFilterPanel(open) {
      $('#filterPanel').toggle(open);
      $('#toggleFiltersCaret')
        .toggleClass('fa-caret-down', !open)
        .toggleClass('fa-caret-up', open);
      try {
        localStorage.setItem('spiV6FiltersOpen', open ? '1' : '0');
      } catch (e) { /* private browsing; the panel just forgets */ }
    }

    $('#toggleFilters').on('click', function () {
      setFilterPanel($('#filterPanel').is(':hidden'));
    });

    $('#clearFilters').on('click', function () {
      $('#date').val('');
      $('#auditRndNo, #affiliation, #scoreLevel, #testPoint, #showAudits, #facilityLink').val('');
      $('#country, #province, #district').val(null).trigger('change');
      $('.testPointNameSection').empty();
      updateFilterCount();
      // Clearing by script fires no event for the plain controls, so highlight by hand.
      filterHighlighter.refresh();
      search();
    });

    /* Highlights each control that holds a value, so an open panel shows which
       filters are doing the filtering. The badge covers the closed case. */
    var filterHighlighter = initFilterHighlighter('#filterPanel');

    $(document).on('change', FILTER_IDS.join(',') + ', #testPointName', updateFilterCount);

    /* Exposed on window because the card's handlers live outside this closure.
       Each row hides itself at zero, and the card hides when no row is left, so a
       clean instance renders nothing above the table. */
    window.updateNeedsAttention = function (unassigned, duplicates) {
      unassigned = parseInt(unassigned, 10) || 0;
      duplicates = parseInt(duplicates, 10) || 0;

      $('#naUnassignedCount').text(unassigned);
      $('#naUnassignedLabel').text(unassigned === 1
        ? <?= json_encode($this->translate('audit is not linked to a facility')); ?>
        : <?= json_encode($this->translate('audits are not linked to a facility')); ?>);
      $('#naUnassigned').toggle(unassigned > 0);

      $('#naDuplicatesCount').text(duplicates);
      $('#naDuplicatesLabel').text(duplicates === 1
        ? <?= json_encode($this->translate('duplicate submission')); ?>
        : <?= json_encode($this->translate('duplicate submissions')); ?>);
      $('#naDuplicates').toggle(duplicates > 0);

      /* Counted from the data, not with :visible. The card itself is still hidden
         at this point, and jQuery reports every descendant of a hidden element as
         not visible, so the count came back 0 and the card never opened. */
      var shown = (unassigned > 0 ? 1 : 0) + (duplicates > 0 ? 1 : 0);
      $('#naCount').text(shown);
      $('#needsAttention').toggle(shown > 0);
    };

    window.showUnassignedAudits = function () {
      $('#facilityLink').val('unassigned');
      updateFilterCount();
      filterHighlighter.refresh();
      search();
    };

    var filtersOpen = null;
    try {
      filtersOpen = localStorage.getItem('spiV6FiltersOpen');
    } catch (e) { /* as above */ }
    setFilterPanel(filtersOpen === '1');
    updateFilterCount();
  });

