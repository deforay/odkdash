<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.1/dist/js/tom-select.complete.min.js" type="text/javascript"></script>
<script type="text/javascript" src="<?php echo $this->basePath('assets/js/jquery.dataTables.min.js'); ?>"></script>
<script type="text/javascript" src="<?php echo $this->basePath('assets/js/dataTables.bootstrap.min.js'); ?>"></script>
<script type="text/javascript" src="<?php echo $this->basePath('assets/js/jquery.blockUI.min.js'); ?>"></script>
<script type="text/javascript">
  table = null;
  $(document).ready(function() {
    // Keep the server's grouping so copies of one audit stay together.
    table = $('#example').DataTable({
      order: [],
      language: { emptyTable: "<?= $this->translate('No Data Available'); ?>" }
    });
  });

  function removeData(id) {
    var conf = confirm("<?= $this->translate('Are you sure you want to remove this duplicate audit?'); ?>");
    if (conf) {
      $.post("<?php echo $this->url('spi-v6-form', array('action' => 'remove-audit')); ?>", { id: id }, function(data) {
        if (data > 0) {
          alert("<?= $this->translate('Audit removed successfully'); ?>");
          table.row('#audit-' + id).remove().draw(false);
        }
      });
    }
  }
</script>
