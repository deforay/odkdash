            <th style="width:8%;"><?= $this->translate('Action'); ?></th>
          </tr>
        </thead>
        <tbody>
          <?php
          // Rows arrive grouped by meta-instance-id, oldest first: the first
          // copy in each group is kept, every later copy can be removed.
          $previousInstanceId = null;
          foreach ($result as $duplicate) {
            $isFirstCopy = $duplicate['meta-instance-id'] !== $previousInstanceId;
            $previousInstanceId = $duplicate['meta-instance-id'];
          ?>
            <tr id="audit-<?php echo (int) $duplicate['id']; ?>">
              <td><?php echo $this->escapeHtml($duplicate['facilityname']); ?></td>
              <td><?php echo $this->escapeHtml($duplicate['auditroundno']); ?></td>
              <td><?php echo CommonService::humanReadableDateFormat($duplicate['assesmentofaudit']); ?></td>
              <td><?php echo $this->escapeHtml($duplicate['testingpointname']); ?></td>
              <td><?php echo $this->escapeHtml($duplicate['testingpointtype']); ?></td>
              <td><?php echo $this->escapeHtml($duplicate['level']); ?></td>
              <td><?php echo $this->escapeHtml($duplicate['affiliation']); ?></td>
              <td><?php echo round((float) ($duplicate['AUDIT_SCORE_PERCENTAGE']), 2); ?></td>
              <td><?php echo $this->escapeHtml($duplicate['status']); ?></td>
              <td>
                <?php if ($isFirstCopy) { ?>
                  <?= $this->translate('Kept'); ?>
                <?php } else { ?>
                  <a class="btn btn-danger btn-sm" href="javascript:void(0);" onclick="removeData(<?php echo (int) $duplicate['id']; ?>);"><?= $this->translate('Remove'); ?></a>
                <?php } ?>
              </td>
            </tr>
          <?php } ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script src="<?php echo $this->basePath('assets/js/jquery.js'); ?>" type="text/javascript"></script>
