  /**
   * Themed replacement for window.confirm.
   *
   * opts: {title, name, meta, body, confirmLabel, destructive, requireText}. The
   * record being acted on is named by `name` with `meta` as a quiet detail line.
   * Pass requireText
   * for destructive actions and the button stays disabled until that exact text is
   * typed, so a delete cannot be fired by reflex on the wrong row.
   *
   * Handlers are bound per call and namespaced, so a dialog dismissed and reopened
   * for a different row cannot fire the previous row's action.
   */
  function confirmDialog(opts, onConfirm) {
    var $ok = $('#confirmModalOk');
    var $wrap = $('#confirmModalTypeWrap');
    var $input = $('#confirmModalType');
    var token = opts.requireText ? String(opts.requireText) : '';

    $('#confirmModalTitle').text(opts.title);
    $('#confirmModalBody').text(opts.body || '').toggle(!!opts.body);
    $ok.text(opts.confirmLabel)
      .removeClass('cf-go cf-go-safe')
      .addClass(opts.destructive ? 'cf-go' : 'cf-go-safe');

    $('#confirmModalName').text(opts.name || '').toggle(!!opts.name);

    // meta: short strings shown as one dot-separated line under the name.
    var $meta = $('#confirmModalMeta').empty();
    var meta = $.grep(opts.meta || [], function (v) { return $.trim(v || '') !== ''; });
    $.each(meta, function (i, v) { $meta.append($('<span>').text(v)); });
    $meta.toggle(meta.length > 0);

    $('#confirmModalToken').text(token);
    $('#confirmModalCopyLabel').text(<?= json_encode($this->translate('Copy')); ?>);
    $('#confirmModalCopy').removeClass('cf-copied');
    $wrap.toggle(!!token);
    $input.val('').off('input.confirmDialog');
    $ok.prop('disabled', !!token);

    if (token) {
      $input.on('input.confirmDialog', function () {
        $ok.prop('disabled', $.trim(this.value).toUpperCase() !== token.toUpperCase());
      });
    }

    $('#confirmModalCopy').off('click.confirmDialog').on('click.confirmDialog', function () {
      var $btn = $(this);
      var text = $('#confirmModalToken').text();
      var copied = false;

      /* execCommand needs a selection and is deprecated, but it works without a
         secure context, which the Clipboard API requires and a plain-HTTP
         deployment will not have. Try it first, then fall back. */
      var scratch = document.createElement('textarea');
      scratch.value = text;
      scratch.setAttribute('readonly', '');
      scratch.style.position = 'fixed';
      scratch.style.opacity = '0';
      document.body.appendChild(scratch);
      scratch.select();
      try {
        copied = document.execCommand('copy');
      } catch (e) { /* fall through */ }
      document.body.removeChild(scratch);

      if (!copied && navigator.clipboard) {
        navigator.clipboard.writeText(text);
        copied = true;
      }

      if (copied) {
        $('#confirmModalCopyLabel').text(<?= json_encode($this->translate('Copied')); ?>);
        $btn.addClass('cf-copied');
      }
      $input.trigger('focus');
    });

    $ok.off('click.confirmDialog').on('click.confirmDialog', function () {
      if ($ok.prop('disabled')) {
        return;
      }
      $('#confirmModal').modal('hide');
      onConfirm();
    });

    // Focus the field once the modal has finished animating in.
    $('#confirmModal').off('shown.bs.modal.confirmDialog')
      .on('shown.bs.modal.confirmDialog', function () {
        if (token) {
          $input.trigger('focus');
        }
      })
      .modal('show');
  }

  function deleteAudit(auditId, facilityName) {
    if ($.trim(auditId) == "") {
      alert("<?= $this->translate('Oops! We have experienced a problem. Please try again!'); ?>");
      return;
    }

    /* Spell out which audit this is. The id means nothing to anyone — it is in no
       column — so the row is named by the columns actually on screen, and the text
       to type is the facility name. An audit with no facility name falls back to
       the literal word, since there is nothing else to key it on. */
    var $cells = $('#' + auditId + ' td');
    var name = $.trim(facilityName || '');
    var cell = function (i) { return $.trim($cells.eq(i).text()); };

    confirmDialog({
      title: <?= json_encode($this->translate('Delete this audit?')); ?>,
      name: name || <?= json_encode($this->translate('(no facility name)')); ?>,
      meta: [
        cell(4),
        cell(3) ? <?= json_encode($this->translate('Round')); ?> + ' ' + cell(3) : '',
        cell(5),
        cell(7) ? <?= json_encode($this->translate('Score')); ?> + ' ' + cell(7) : '',
        cell(8)
      ],
      body: <?= json_encode($this->translate('It will be removed from the list and from every total and chart.')); ?>,
      confirmLabel: <?= json_encode($this->translate('Delete')); ?>,
      destructive: true,
      requireText: name || <?= json_encode($this->translate('DELETE')); ?>
    }, function () {
      $.post("<?php echo $this->url('spi-v6-form', array('action' => 'delete')); ?>", {
        deleteId: auditId
      },
        function (data) {
          if (data == 0) {
            alert("<?= $this->translate('Oops! We have experienced a problem. Please try again!'); ?>");
          } else {
            // Redraw rather than drop the row: the counts and the Needs attention
            // card come from the same response and would otherwise go stale.
            table.draw(false);
          }
        });
    });
  }

