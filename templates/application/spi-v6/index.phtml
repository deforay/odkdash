<script type="text/javascript">
  table = null;

  function formatValue(value) {
    //return '<a href="/spi-v3/print/'+value+'" target="_blank"><i class="fa fa-print"></i> Print Full Survey</a>'
    return '<a href="javascript:void(0);" onclick="downloadPdf(' + value + ')" ><i class="fa fa-print"></i> <?= $this->translate('Print Full Survey'); ?></a>' +
      '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;' +
      '<a href="javascript:void(0)" onclick="downloadCorrectiveActionPdf(' + value + ')" ><i class="fa fa-print"></i> <?= $this->translate('Print Corrective Actions'); ?></a>';
  }
  
  $(document).ready(function () {
    var startDate = "";
    var endDate = "";
    // $("#province").multipleSelect({
    //   placeholder: '< ?= $this->translate('Select Province/District(s)'); ?>',
    //   width: '100%'
    // });
    $('#date').daterangepicker({
      format: 'DD-MMM-YYYY',
      startDate: moment().subtract('days', 29),
      endDate: moment(),
      maxDate: moment(),
      ranges: {
        '<?= $this->translate('Today'); ?>': [moment(), moment()],
				'<?= $this->translate('Yesterday'); ?>': [moment().subtract('days', 1), moment().subtract('days', 1)],
				'<?= $this->translate('Last 7 Days'); ?>': [moment().subtract('days', 6), moment()],
				'<?= $this->translate('Last 30 Days'); ?>': [moment().subtract('days', 29), moment()],
				'<?= $this->translate('This Month'); ?>': [moment().startOf('month'), moment().endOf('month')],
				'<?= $this->translate('Last Month'); ?>': [moment().subtract('month', 1).startOf('month'), moment().subtract('month', 1).endOf('month')],
				'<?= $this->translate('Last 6 Months'); ?>': [moment().subtract('months', 6), moment()],
				'<?= $this->translate('Last 12 Months'); ?>': [moment().subtract('months', 12), moment()],
				'<?= $this->translate('Last 18 Months'); ?>': [moment().subtract('months', 18), moment()],
				'<?= $this->translate('Last 2 Years'); ?>': [moment().subtract('years', 2), moment()]
      }
    },
      function (start, end) {
        startDate = start.format('YYYY-MM-DD');
        endDate = end.format('YYYY-MM-DD');
        /* This build of daterangepicker reports through this callback rather than
         * firing apply.daterangepicker, so the highlighter never hears about a date
         * being picked and the field stayed unhighlighted until some other filter
         * changed. Tell it directly. */
        filterHighlighter.refresh();
        updateFilterCount();
      });
    table = $('#example').DataTable({
      "bProcessing": true,
      "bServerSide": true,
      "aoColumns": [
        <?php echo $editAction; ?>
      ],
      "iDisplayLength": 50,
      "pageLength": 50,
      // Audit Date, index 4 now that the select column sits at 0.
      "aaSorting": [
        [4, "desc"]
      ],
      "sAjaxSource": "<?php echo $this->url('spi-v6-form', array('action' => 'index')); ?>",
      "fnServerData": function (sSource, aoData, fnCallback) {
        aoData.push({
          "name": "auditRndNo",
          "value": $("#auditRndNo").val()
        });
        aoData.push({
          "name": "dateRange",
          "value": $("#date").val()
        });
