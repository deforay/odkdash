<!-- Themed confirmation, replacing window.confirm for the destructive and bulk
     actions. Driven through confirmDialog() below rather than per-action markup,
     so the title, body and button wording come from the caller. -->
<div class="modal fade confirm-modal" id="confirmModal" tabindex="-1" role="dialog"
  aria-labelledby="confirmModalTitle">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        <h4 class="modal-title" id="confirmModalTitle"></h4>
      </div>
      <div class="modal-body">
        <!-- The record leads: its name large, everything else as one quiet line.
             A six-row table gave every field equal weight and buried the one thing
             worth reading. -->
        <div class="cf-name" id="confirmModalName"></div>
        <div class="cf-meta" id="confirmModalMeta"></div>
        <p class="cf-warning" id="confirmModalBody"></p>

        <!-- Type-to-confirm. The token gets its own block so copying is an obvious
             affordance rather than a third identical input in a stack. -->
        <div id="confirmModalTypeWrap" style="display:none;">
          <div class="cf-token">
            <div class="cf-token-label"><?= $this->translate('Type this to confirm'); ?></div>
            <div class="cf-token-value">
              <span class="cf-token-text" id="confirmModalToken"></span>
              <button class="cf-copy" type="button" id="confirmModalCopy">
                <i class="fa fa-clone" aria-hidden="true"></i>
                <span id="confirmModalCopyLabel"><?= $this->translate('Copy'); ?></span>
              </button>
            </div>
          </div>
          <input type="text" class="form-control cf-type" id="confirmModalType" autocomplete="off"
            placeholder="<?= $this->translate('Type it here to enable the button'); ?>">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">
          <?= $this->translate('Cancel'); ?>
        </button>
        <button type="button" class="btn" id="confirmModalOk"></button>
      </div>
    </div>
  </div>
</div>

