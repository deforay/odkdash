    /* The filter panel filled the screen before a single audit was visible, so it
       starts closed and the audit list is what you land on. Hiding filters hides
       what they are doing, so the badge counts the ones that are set — otherwise a
       filtered list is indistinguishable from the whole list. The open/closed
       choice is remembered for people who keep it open. */
    var FILTER_IDS = ['#date', '#auditRndNo', '#affiliation', '#scoreLevel', '#country',
      '#province', '#district', '#testPoint', '#showAudits', '#facilityLink'];

    function updateFilterCount() {
      var n = 0;
      $.each(FILTER_IDS, function (i, id) {
        var v = $(id).val();
        if ($.isArray(v)) {
          // "All" is an empty-valued option inside the multi-selects.
          if ($.grep(v, function (x) { return x !== '' && x !== null; }).length) {
            n++;
          }
        } else if (v !== '' && v !== null && typeof v !== 'undefined') {
          n++;
        }
      });
      $('#activeFilterCount').text(n > 0 ? ' (' + n + ')' : '');
      $('#clearFilters').toggle(n > 0);
    }

    function setFilterPanel(open) {
      $('#filterPanel').toggle(open);
      $('#toggleFiltersCaret')
        .toggleClass('fa-caret-down', !open)
        .toggleClass('fa-caret-up', open);
      try {
        localStorage.setItem('spiV6FiltersOpen', open ? '1' : '0');
      } catch (e) { /* private browsing; the panel just forgets */ }
    }

    $('#toggleFilters').on('click', function () {
      setFilterPanel($('#filterPanel').is(':hidden'));
    });

    $('#clearFilters').on('click', function () {
      $('#date').val('');
      $('#auditRndNo, #affiliation, #scoreLevel, #testPoint, #showAudits, #facilityLink').val('');
      $('#country, #province, #district').val(null).trigger('change');
      $('.testPointNameSection').empty();
      updateFilterCount();
      // Clearing by script fires no event for the plain controls, so highlight by hand.
      filterHighlighter.refresh();
      search();
    });

    /* Highlights each control that holds a value, so an open panel shows which
       filters are doing the filtering. The badge covers the closed case. */
    var filterHighlighter = initFilterHighlighter('#filterPanel');

    $(document).on('change', FILTER_IDS.join(',') + ', #testPointName', updateFilterCount);

    /* Bulk approve. The checkboxes are rebuilt on every draw, so the handlers are
       delegated and the running count is recomputed rather than tracked. Selection
       does not survive a redraw, which is why approving redraws last. */
    function refreshApproveSelection() {
      var n = $('#example tbody input.approveSelect:checked').length;
      $('#approveSelectedCount').text(n > 0 ? '(' + n + ')' : '');
      $('#approveSelected').toggle(n > 0);

      var total = $('#example tbody input.approveSelect').length;
      $('#approveSelectAll').prop('checked', total > 0 && n === total);
    }

    $('#example tbody').on('change', 'input.approveSelect', refreshApproveSelection);

    // Rows are replaced on every draw, so the count and the button follow them.
    $('#example').on('draw.dt', refreshApproveSelection);

    $('#approveSelectAll').on('change', function () {
      $('#example tbody input.approveSelect').prop('checked', $(this).is(':checked'));
      refreshApproveSelection();
    });

    $('#approveSelected').on('click', function () {
      var ids = $('#example tbody input.approveSelect:checked').map(function () {
        return this.value;
      }).get();
      if (!ids.length) {
        return;
      }
      confirmDialog({
        title: <?= json_encode($this->translate('Approve selected audits')); ?>,
        body: ids.length + ' ' + <?= json_encode($this->translate('audits will be marked as final, and a facility created for any that does not have one yet.')); ?>,
        confirmLabel: <?= json_encode($this->translate('Approve')); ?>
      }, function () {
        $.blockUI();
        $.post("<?php echo $this->url('spi-v6-form', array('action' => 'approve-status')); ?>", {
          idList: ids
        },
          function (data) {
            $.unblockUI();
            if (data > 0) {
              alert("<?= $this->translate('Audit updated successfully'); ?>");
            }
            $('#approveSelectAll').prop('checked', false);
            table.draw(false);
          });
      });
    });

    /* Exposed on window because the card's handlers live outside this closure.
       Each row hides itself at zero, and the card hides when no row is left, so a
       clean instance renders nothing above the table. */
    window.updateNeedsAttention = function (unassigned, duplicates) {
      unassigned = parseInt(unassigned, 10) || 0;
      duplicates = parseInt(duplicates, 10) || 0;

      $('#naUnassignedCount').text(unassigned);
      $('#naUnassignedLabel').text(unassigned === 1
        ? <?= json_encode($this->translate('audit is not linked to a facility')); ?>
        : <?= json_encode($this->translate('audits are not linked to a facility')); ?>);
      $('#naUnassigned').toggle(unassigned > 0);

      $('#naDuplicatesCount').text(duplicates);
      $('#naDuplicatesLabel').text(duplicates === 1
        ? <?= json_encode($this->translate('duplicate submission')); ?>
        : <?= json_encode($this->translate('duplicate submissions')); ?>);
      $('#naDuplicates').toggle(duplicates > 0);

      /* Counted from the data, not with :visible. The card itself is still hidden
         at this point, and jQuery reports every descendant of a hidden element as
         not visible, so the count came back 0 and the card never opened. */
      var shown = (unassigned > 0 ? 1 : 0) + (duplicates > 0 ? 1 : 0);
      $('#naCount').text(shown);
      $('#needsAttention').toggle(shown > 0);
    };

    window.showUnassignedAudits = function () {
      $('#facilityLink').val('unassigned');
      updateFilterCount();
      filterHighlighter.refresh();
      search();
    };

    var filtersOpen = null;
    try {
      filtersOpen = localStorage.getItem('spiV6FiltersOpen');
    } catch (e) { /* as above */ }
    setFilterPanel(filtersOpen === '1');
    updateFilterCount();
  });

