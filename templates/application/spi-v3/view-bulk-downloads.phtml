<?php
// Rows from getBulkDownloads('v3'): the signed-in user's requests, or
// everyone's for a Super Admin. The link goes through bulk-file, which checks
// the requester again before sending the archive.
?>
<div class="am-content">
  <div class="page-head">
    <h2><?= $this->translate('View Bulk Downloads'); ?></h2>
  </div>

  <div class="main-content">
    <div class="widget widget-fullwidth widget-small" style="padding:5px;">
      <?php if (count($result) === 0) { ?>
        <p><?= $this->translate('No bulk downloads yet.'); ?></p>
      <?php } else { ?>
        <table class="table table-bordered table-condensed table-striped">
          <thead>
            <tr>
              <th><?= $this->translate('Request'); ?></th>
              <th><?= $this->translate('Requested by'); ?></th>
              <th><?= $this->translate('Audit Round No'); ?></th>
              <th><?= $this->translate('Audit Date'); ?></th>
              <th><?= $this->translate('Archive'); ?></th>
            </tr>
          </thead>
          <tbody>
            <?php foreach ($result as $row) { ?>
              <tr>
                <td><?= (int) $row['r_download_id']; ?></td>
                <td><?= $this->escapeHtml((string) ($row['login'] ?? '')); ?></td>
                <td><?= $this->escapeHtml((string) ($row['auditroundno'] ?? $this->translate('All'))); ?></td>
                <td><?= $this->escapeHtml((string) ($row['assesmentofaudit'] ?? $this->translate('All'))); ?></td>
                <td>
                  <?php if (!empty($row['file_name'])) { ?>
                    <a href="<?= $this->url('spi-v3-form', ['action' => 'bulk-file', 'id' => (int) $row['r_download_id']]); ?>"><?= $this->escapeHtml((string) $row['file_name']); ?></a>
                  <?php } elseif ((int) $row['download_status'] === 0) { ?>
                    <?= $this->translate('Queued'); ?>
                  <?php } else { ?>
                    <?= $this->translate('No file'); ?>
                  <?php } ?>
                </td>
              </tr>
            <?php } ?>
          </tbody>
        </table>
      <?php } ?>
    </div>
  </div>
</div>
