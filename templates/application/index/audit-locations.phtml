<?php
$icon = $this->basePath('assets/img/map-points/dark-green.png');
?>
<div class="map" id="map" style="height: 100%;width:100%;"></div>
<link rel="stylesheet" href="<?php echo $this->basePath('assets/css/leaflet.css'); ?>" type="text/css" />
<script type="text/javascript" src="<?php echo $this->basePath('assets/js/leaflet.js'); ?>"></script>
<script>
	$(document).ready(function() {
		var lat = <?php echo \Application\Service\CommonService::jsonEncode($configData['latitude'] ?? ''); ?>;
		var log = <?php echo \Application\Service\CommonService::jsonEncode($configData['longitude'] ?? ''); ?>;
		var zoomLevel = <?php echo \Application\Service\CommonService::jsonEncode($configData['dashboard_map_zoomlevel'] ?? '4'); ?>;

		var LeafIcon = L.Icon.extend({});
		var map = L.map('map', {
			zoomControl: false,
			scrollWheelZoom: true,
			inertia: false,
			zoomAnimation: false,
			minZoom: 3,
			maxBounds: [
				[-90.0, -180.0],
				[90.0, 180.0]
			]
		}).setView([lat, log], zoomLevel);
		new L.Control.Zoom({
			position: 'topleft'
		}).addTo(map);
		map._onResize();

		L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
			attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
		}).addTo(map);

		// visualize the markers on the map
		<?php foreach ($points as $point) {
			$score = $point['score'];
			if ($score >= 90) {
				$icon = $this->basePath('assets/img/map-points/dark-green.png');
			} else if ($score >= 80 && $score < 90) {
				$icon = $this->basePath('assets/img/map-points/light-green.png');
			} else if ($score >= 60 && $score < 80) {
				$icon = $this->basePath('assets/img/map-points/yellow.png');
			} else if ($score >= 40 && $score < 60) {
				$icon = $this->basePath('assets/img/map-points/orange.png');
			} else {
				$icon = $this->basePath('assets/img/map-points/red.png');
			}
		?>
			L.marker([<?php echo \Application\Service\CommonService::jsonEncode($point['latitude']); ?>, <?php echo \Application\Service\CommonService::jsonEncode($point['longitude']); ?>], {
				icon: new LeafIcon({
					iconUrl: "<?php echo $icon; ?>"
				})
			}).addTo(map);
		<?php } ?>

	});
</script>
